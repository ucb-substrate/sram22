---
import "../styles/theme.css";
import macros from "../data/macros.json";

const base = import.meta.env.BASE_URL;
const repo = "https://github.com/rahulk29/sram22";
const macrosRepo = macros.repo;

const total = macros.macros.length;
const validated = macros.macros.filter((m) => m.silicon_validated).length;

const logoMark = `<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="SRAM22 logo">
  <defs>
    <linearGradient id="sram-die-h" x1="6" y1="6" x2="58" y2="58" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#1b2845"/><stop offset="0.55" stop-color="#274060"/><stop offset="1" stop-color="#335c81"/>
    </linearGradient>
  </defs>
  <rect x="6" y="6" width="52" height="52" rx="13" fill="url(#sram-die-h)"/>
  <rect x="6.75" y="6.75" width="50.5" height="50.5" rx="12.25" fill="none" stroke="#65afff" stroke-opacity="0.35" stroke-width="1.5"/>
  <g stroke="#65afff" stroke-opacity="0.18" stroke-width="1"><line x1="32" y1="12" x2="32" y2="52"/><line x1="12" y1="32" x2="52" y2="32"/></g>
  <g fill="#65afff" fill-opacity="0.30"><rect x="15" y="15" width="8" height="8" rx="2.2"/><rect x="27" y="15" width="8" height="8" rx="2.2"/><rect x="39" y="15" width="8" height="8" rx="2.2"/><rect x="15" y="39" width="8" height="8" rx="2.2"/><rect x="27" y="39" width="8" height="8" rx="2.2"/><rect x="39" y="39" width="8" height="8" rx="2.2"/></g>
  <g fill="#65afff"><rect x="15" y="27" width="8" height="8" rx="2.2"/><rect x="39" y="27" width="8" height="8" rx="2.2"/></g>
  <rect x="27" y="27" width="8" height="8" rx="2.2" fill="#cfe6ff"/>
</svg>`;

const ghIcon = `<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>`;

const features = [
  {
    title: "Parametric",
    body: "Depth, word width, column-mux ratio (4 or 8), and write granularity are set in a TOML file. The decoders, drivers, and self-timed control are sized accordingly.",
  },
  {
    title: "Complete view set",
    body: "Each run emits GDS, a LEF abstract, a SPICE netlist, Liberty (.lib) timing for multiple PVT corners, and a Verilog behavioral model.",
  },
  {
    title: "P&R integration",
    body: "Instantiated as a hard macro in OpenROAD or Cadence Genus/Innovus, placed rotated 90° in one of four legal orientations.",
  },
  {
    title: "Measured in silicon",
    body: `${validated} of the ${total} published macros have been taped out on SKY130 and verified functional at VDD = 1.8 V, 25 MHz.`,
  },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>SRAM22 — configurable SRAM generator for SKY130</title>
    <meta
      name="description"
      content="Configurable single-port SRAM generator for the SKY130 process. Produces GDS, LEF, SPICE, Liberty timing, and a Verilog model from a short TOML description."
    />
    <meta property="og:title" content="SRAM22 — SRAM generator for SKY130" />
    <meta
      property="og:description"
      content="Configurable single-port SRAM generator for the SKY130 process."
    />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <div class="page">
      <header class="nav">
        <a class="brand" href={base} aria-label="SRAM22 home">
          <span class="brand-mark" set:html={logoMark} />
          <span class="brand-name">SRAM<span class="brand-22">22</span></span>
        </a>
        <nav class="nav-links">
          <a href={`${base}docs/`}>Docs</a>
          <a href={`${base}docs/quickstart/`}>Quickstart</a>
          <a href={repo} class="nav-gh">GitHub ↗</a>
        </nav>
      </header>

      <main>
        <section class="hero">
          <p class="eyebrow">Single-port SRAM generator · SKY130 · open source</p>
          <h1>
            Configurable SRAM macros for <span class="grad">SKY130</span>.
          </h1>
          <p class="lede">
            SRAM22 generates single-port SRAM macros from a short TOML
            description — depth, word width, column-mux ratio, and write
            granularity. Each run produces GDS, LEF, SPICE, Liberty timing across
            PVT corners, and a Verilog model.
          </p>
          <div class="cta">
            <a class="btn btn-primary" href={`${base}docs/`}> Documentation </a>
            <a class="btn btn-ghost" href={repo}>
              <span set:html={ghIcon} /> Source on GitHub
            </a>
          </div>

          <dl class="stats">
            <div><dt>{total}</dt><dd>published macros</dd></div>
            <div><dt>{validated}</dt><dd>silicon-validated</dd></div>
            <div><dt>SKY130</dt><dd>open PDK</dd></div>
            <div><dt>BSD-3</dt><dd>licensed</dd></div>
          </dl>
        </section>

        <section class="features">
          {
            features.map((f) => (
              <article class="card">
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </article>
            ))
          }
        </section>

        <section class="showcase">
          <div class="showcase-text">
            <h2>Inspect a generated macro</h2>
            <p>
              The layout below is <code>sram22_64x32m4w8</code> — a 64-word ×
              32-bit macro — rendered from its GDS. Browse it layer by layer,
              inspect each pin's physical position, and view the internal read
              waveforms in the docs.
            </p>
            <div class="showcase-links">
              <a href={`${base}docs/internals/layout/`}>Layout browser →</a>
              <a href={`${base}docs/interface/pin-positions/`}>Pin positions →</a>
              <a href={`${base}docs/internals/waveforms/`}>Waveforms →</a>
            </div>
          </div>
          <a class="showcase-figure" href={`${base}docs/internals/layout/`}>
            <img
              src={`${base}layout/composite_preview.webp`}
              width="2200"
              height="1166"
              alt="GDS layout of the sram22_64x32m4w8 macro"
              loading="lazy"
            />
            <span class="showcase-cap">sram22_64x32m4w8 · 360.32 × 191.00 µm</span>
          </a>
        </section>

        <section class="get-started">
          <h2>Install and generate</h2>
          <p>Install the generator, write a config, and run:</p>
          <pre class="code"><code>{`git clone ${repo}.git
cd sram22 && make install && cd -

# describe the SRAM you want
cat > sram22.toml <<'TOML'
num_words  = 64
data_width = 32
mux_ratio  = 4
write_size = 8
TOML

sram22            # generates the macro`}</code></pre>
          <div class="cta">
            <a class="btn btn-primary" href={`${base}docs/quickstart/`}>
              Quickstart guide
            </a>
            <a class="btn btn-ghost" href={macrosRepo}>
              Pre-built macros ↗
            </a>
          </div>
        </section>
      </main>

      <footer class="foot">
        <div class="foot-brand">
          <span class="brand-mark sm" set:html={logoMark} />
          <span>SRAM22</span>
        </div>
        <nav class="foot-links">
          <a href={`${base}docs/`}>Documentation</a>
          <a href={repo}>GitHub</a>
          <a href={macrosRepo}>Macro library</a>
          <a href={`${repo}/blob/master/LICENSE`}>License</a>
        </nav>
        <p class="foot-note">
          Developed at the Berkeley Wireless Research Center. Generated macros
          are provided without warranty.
        </p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    font-family: var(--sram-font);
    color: var(--sram-text);
    background: var(--sram-bg);
    -webkit-font-smoothing: antialiased;
  }
  ::selection {
    background: var(--sram-accent);
    color: var(--sram-on-accent);
  }
  a {
    color: var(--sram-accent);
    text-decoration: none;
  }
</style>

<style>
  .page {
    --maxw: 1080px;
    --tint-weak: color-mix(in srgb, var(--sram-sky) 5%, transparent);
    --tint-soft: color-mix(in srgb, var(--sram-sky) 12%, transparent);
    --tint-line: color-mix(in srgb, var(--sram-sky) 22%, transparent);
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(
        1200px 600px at 80% -10%,
        color-mix(in srgb, var(--sram-sky) 18%, transparent),
        transparent 60%
      ),
      radial-gradient(
        900px 500px at 0% 0%,
        color-mix(in srgb, var(--sram-baltic) 35%, transparent),
        transparent 55%
      ),
      linear-gradient(180deg, var(--sram-ink-2) 0%, var(--sram-ink) 100%);
  }
  /* faint bitcell-array grid backdrop */
  .page::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--tint-weak) 1px, transparent 1px),
      linear-gradient(90deg, var(--tint-weak) 1px, transparent 1px);
    background-size: 38px 38px;
    mask-image: radial-gradient(
      ellipse 80% 60% at 50% 0%,
      #000 0%,
      transparent 75%
    );
    pointer-events: none;
  }

  main,
  .nav,
  .foot {
    position: relative;
    max-width: var(--maxw);
    margin: 0 auto;
    padding-inline: 24px;
  }

  /* nav */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 22px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #fff;
  }
  .brand-mark {
    display: inline-flex;
    width: 38px;
    height: 38px;
  }
  .brand-mark.sm {
    width: 26px;
    height: 26px;
  }
  .brand-mark :global(svg) {
    width: 100%;
    height: 100%;
  }
  .brand-name {
    font-weight: 680;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }
  .brand-22 {
    color: var(--sram-accent);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 26px;
    font-weight: 500;
  }
  .nav-links a {
    color: var(--sram-text-dim);
  }
  .nav-links a:hover {
    color: #fff;
  }
  .nav-gh {
    color: #fff !important;
  }

  /* hero */
  .hero {
    padding-block: 72px 56px;
    text-align: center;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--sram-accent-2);
    margin: 0 0 18px;
  }
  .hero h1 {
    font-size: clamp(2.4rem, 6vw, 4.1rem);
    line-height: 1.04;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 auto 22px;
    max-width: 14ch;
    color: #fff;
  }
  .grad {
    background: linear-gradient(
      100deg,
      var(--sram-sky),
      var(--sram-cloud) 60%,
      var(--sram-sky-soft)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede {
    font-size: clamp(1.05rem, 2.2vw, 1.28rem);
    line-height: 1.6;
    color: var(--sram-text-dim);
    max-width: 60ch;
    margin: 0 auto 34px;
  }
  .cta {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 14px 24px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1.02rem;
    border: 1px solid transparent;
    transition:
      transform 0.12s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }
  .btn:hover {
    transform: translateY(-2px);
  }
  .btn-primary {
    background: linear-gradient(
      180deg,
      var(--sram-sky),
      color-mix(in srgb, var(--sram-cloud) 90%, #000)
    );
    color: var(--sram-on-accent);
    box-shadow: 0 10px 30px -10px
      color-mix(in srgb, var(--sram-sky) 60%, transparent);
  }
  .btn-ghost {
    background: var(--tint-weak);
    border-color: var(--tint-line);
    color: var(--sram-text);
  }
  .btn-ghost:hover {
    border-color: var(--sram-accent);
    background: var(--tint-soft);
  }
  .btn svg {
    width: 18px;
    height: 18px;
  }

  /* stats */
  .stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px 48px;
    margin: 52px auto 0;
    padding: 0;
  }
  .stats div {
    text-align: center;
  }
  .stats dt {
    font-size: 2rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.02em;
  }
  .stats dd {
    margin: 2px 0 0;
    font-size: 0.86rem;
    color: var(--sram-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* features */
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
    padding-block: 28px 8px;
  }
  .card {
    background: var(--sram-surface);
    border: 1px solid var(--sram-border);
    border-radius: 16px;
    padding: 22px 22px 24px;
    backdrop-filter: blur(6px);
  }
  .card h3 {
    margin: 0 0 8px;
    font-size: 1.12rem;
    color: #fff;
  }
  .card p {
    margin: 0;
    color: var(--sram-text-dim);
    line-height: 1.55;
    font-size: 0.96rem;
  }

  /* showcase */
  .showcase {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 34px;
    align-items: center;
    padding-block: 64px;
  }
  .showcase h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    margin: 0 0 14px;
    color: #fff;
    letter-spacing: -0.02em;
  }
  .showcase p {
    color: var(--sram-text-dim);
    line-height: 1.6;
    margin: 0 0 18px;
  }
  .showcase code {
    font-family: var(--sram-mono);
    font-size: 0.85em;
    color: var(--sram-sky-pale);
    background: var(--tint-soft);
    padding: 0.1em 0.4em;
    border-radius: 5px;
  }
  .showcase-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-weight: 600;
  }
  .showcase-figure {
    display: block;
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--tint-line);
    box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.8);
    line-height: 0;
  }
  .showcase-figure img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.4s ease;
  }
  .showcase-figure:hover img {
    transform: scale(1.03);
  }
  .showcase-cap {
    position: absolute;
    left: 12px;
    bottom: 10px;
    font-family: var(--sram-mono);
    font-size: 0.74rem;
    color: var(--sram-sky-pale);
    background: color-mix(in srgb, var(--sram-ink) 70%, transparent);
    padding: 4px 9px;
    border-radius: 6px;
    line-height: 1.2;
  }

  /* get started */
  .get-started {
    text-align: center;
    padding-block: 24px 80px;
  }
  .get-started h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    margin: 0 0 10px;
    color: #fff;
    letter-spacing: -0.02em;
  }
  .get-started > p {
    color: var(--sram-text-dim);
    margin: 0 0 22px;
  }
  .code {
    text-align: left;
    max-width: 640px;
    margin: 0 auto 28px;
    background: color-mix(in srgb, var(--sram-ink) 80%, #000);
    border: 1px solid var(--tint-line);
    border-radius: 14px;
    padding: 20px 22px;
    overflow-x: auto;
  }
  .code code {
    font-family: var(--sram-mono);
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--sram-sky-pale);
    white-space: pre;
  }

  /* footer */
  .foot {
    border-top: 1px solid var(--sram-border);
    padding-block: 30px 48px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
    text-align: center;
  }
  .foot-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 650;
    color: #fff;
  }
  .foot-links {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .foot-links a {
    color: var(--sram-text-dim);
  }
  .foot-note {
    color: var(--sram-text-muted);
    font-size: 0.85rem;
    margin: 0;
    max-width: 52ch;
  }

  @media (max-width: 760px) {
    .showcase {
      grid-template-columns: 1fr;
    }
    .nav-links {
      gap: 16px;
      font-size: 0.92rem;
    }
    .nav-links a:nth-child(2) {
      display: none;
    }
  }
</style>
