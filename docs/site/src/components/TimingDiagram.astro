---
import timing from "../data/timing.json";

// Representative values (rounded for display) pulled from the real .lib.
// Prefer the address arc, but fall back to any available arc so a regenerated
// timing.json that omits `addr` (extract_data emits arcs conditionally) still
// builds.
const fmt = (v: number) => (v < 1 ? v.toFixed(2) : v.toFixed(1));
const anyArc = (m: Record<string, { repr: number }>) =>
  m.addr ?? Object.values(m)[0] ?? { repr: 0 };
const tSU = fmt(anyArc(timing.setup).repr);
const tH = fmt(anyArc(timing.hold).repr);
const tCQ = fmt(timing.clk_q.min);
const corner = timing.corner_label;

// ---- geometry (schematic; not to time-scale) ----
const W = 820;
const L = 92; // label gutter
const x0 = L + 8;
const xEnd = 792;
const rowH = 34;
const gap = 14;
const top0 = 24;

const rows = ["clk", "ce", "we", "addr", "din", "dout"];
const rowTop: Record<string, number> = {};
rows.forEach((r, i) => (rowTop[r] = top0 + i * (rowH + gap)));
const H = top0 + rows.length * (rowH + gap) + 30;

// rising clock edges
const E0 = 250; // READ launch
const E1 = 520; // WRITE launch
const hi = (t: number) => rowTop[t] + 6;
const lo = (t: number) => rowTop[t] + rowH - 6;
const mid = (t: number) => rowTop[t] + rowH / 2;

// 1-bit signal path; pts = [{x, v}] level v∈{0,1} starting at x.
function bit(row: string, pts: { x: number; v: 0 | 1 }[]) {
  const y = (v: 0 | 1) => (v ? hi(row) : lo(row));
  let d = `M ${pts[0].x} ${y(pts[0].v)}`;
  for (let i = 1; i < pts.length; i++) {
    d += ` H ${pts[i].x} V ${y(pts[i].v)}`;
  }
  d += ` H ${xEnd}`;
  return d;
}

// bus hexagon segments
const cw = 7;
function busPolys(row: string, segs: { x0: number; x1: number }[]) {
  return segs.map((s) => {
    const h = hi(row),
      l = lo(row),
      m = mid(row);
    const left =
      s.x0 <= x0 ? `${s.x0},${h} ${s.x0},${l}` : `${s.x0 + cw},${h} ${s.x0},${m} ${s.x0 + cw},${l}`;
    const right =
      s.x1 >= xEnd
        ? `${s.x1},${l} ${s.x1},${h}`
        : `${s.x1 - cw},${l} ${s.x1},${m} ${s.x1 - cw},${h}`;
    // order: top-left -> top-right -> right -> bottom-right -> bottom-left -> left
    const tl = s.x0 <= x0 ? `${s.x0},${h}` : `${s.x0 + cw},${h}`;
    const tr = s.x1 >= xEnd ? `${s.x1},${h}` : `${s.x1 - cw},${h}`;
    const rr = s.x1 >= xEnd ? `${s.x1},${l}` : `${s.x1},${m} ${s.x1 - cw},${l}`;
    const bl = s.x0 <= x0 ? `${s.x0},${l}` : `${s.x0 + cw},${l} ${s.x0},${m}`;
    return `${tl} ${tr} ${rr} ${bl}`;
  });
}

// CLK: rises at E0, E1; falls half a period later
const clkPts: { x: number; v: 0 | 1 }[] = [
  { x: x0, v: 0 },
  { x: E0, v: 1 },
  { x: E0 + 110, v: 0 },
  { x: E1, v: 1 },
  { x: E1 + 110, v: 0 },
];
const clkPath = bit("clk", clkPts);
const cePath = bit("ce", [{ x: x0, v: 1 }]); // chip enabled throughout
const wePath = bit("we", [
  { x: x0, v: 0 },
  { x: E1 - 90, v: 1 },
  { x: E1 + 130, v: 0 },
]);

// ADDR: A0 valid for the read, A1 for the write (changes shortly before E1)
const addrSegs = [
  { x0: x0, x1: E1 - 90 },
  { x0: E1 - 90, x1: xEnd },
];
const addrPolys = busPolys("addr", addrSegs);
const addrLabels = [
  { x: (x0 + (E1 - 90)) / 2, y: mid("addr"), t: "A0 (read)" },
  { x: (E1 - 90 + xEnd) / 2, y: mid("addr"), t: "A1 (write)" },
];

// DIN: valid only around the write
const dinSegs = [{ x0: E1 - 90, x1: xEnd }];
const dinPolys = busPolys("din", dinSegs);
const dinLabel = { x: (E1 - 90 + xEnd) / 2, y: mid("din"), t: "D1" };
const dinPre = lo("din"); // before write, din is don't-care (single low line)

// DOUT: invalid until tCQ after E0, then Q(A0)
const doutChange = E0 + 150;
const doutSegs = [{ x0: doutChange, x1: xEnd }];
const doutPolys = busPolys("dout", doutSegs);
const doutLabel = { x: (doutChange + xEnd) / 2, y: mid("dout"), t: "Q(A0)" };
---

<figure class="td">
  <svg viewBox={`0 0 ${W} ${H}`} class="td-svg" role="img"
    aria-label="SRAM read and write timing diagram">
    <!-- clock-edge guides -->
    {
      [E0, E1].map((e) => (
        <line class="td-guide" x1={e} y1={top0 - 6} x2={e} y2={H - 24} />
      ))
    }
    <text class="td-region" x={E0} y={14}>READ</text>
    <text class="td-region" x={E1} y={14}>WRITE</text>

    <!-- row labels -->
    {
      rows.map((r) => (
        <text class="td-label" x={L} y={mid(r) + 4}>
          {r}
        </text>
      ))
    }

    <!-- bit signals -->
    <path class="td-wave" d={clkPath} />
    <path class="td-wave" d={cePath} />
    <path class="td-wave" d={wePath} />

    <!-- addr bus -->
    {addrPolys.map((p) => <polygon class="td-bus" points={p} />)}
    {addrLabels.map((s) => <text class="td-buslabel" x={s.x} y={s.y + 4}>{s.t}</text>)}

    <!-- din: low line before write, bus during write -->
    <line class="td-wave" x1={x0} y1={dinPre} x2={E1 - 90} y2={dinPre} />
    {dinPolys.map((p) => <polygon class="td-bus" points={p} />)}
    <text class="td-buslabel" x={dinLabel.x} y={dinLabel.y + 4}>{dinLabel.t}</text>

    <!-- dout: invalid (hatched) then valid bus -->
    <rect class="td-invalid" x={x0} y={hi("dout")} width={doutChange - x0}
      height={lo("dout") - hi("dout")} />
    <text class="td-invlabel" x={(x0 + doutChange) / 2} y={mid("dout") + 4}>invalid</text>
    {doutPolys.map((p) => <polygon class="td-bus" points={p} />)}
    <text class="td-buslabel" x={doutLabel.x} y={doutLabel.y + 4}>{doutLabel.t}</text>

    <!-- annotations: tSU, tH on addr@E0 ; tCQ on dout -->
    <!-- setup/hold are drawn exaggerated; labels carry the real values -->
    <g class="td-ann">
      <line x1={E0 - 60} y1={rowTop["addr"] - 4} x2={E0 - 60} y2={lo("addr") + 6} />
      <line x1={E0} y1={rowTop["addr"] - 4} x2={E0} y2={lo("addr") + 6} />
      <line class="td-dim" x1={E0 - 60} y1={rowTop["addr"] - 2} x2={E0} y2={rowTop["addr"] - 2} />
      <text class="td-anntext" x={E0 - 30} y={rowTop["addr"] - 6}>tSU≈{tSU}ns</text>

      <line x1={E0 + 38} y1={rowTop["addr"] - 4} x2={E0 + 38} y2={lo("addr") + 6} />
      <line class="td-dim" x1={E0} y1={lo("addr") + 10} x2={E0 + 38} y2={lo("addr") + 10} />
      <text class="td-anntext" x={E0 + 19} y={lo("addr") + 22}>tH≈{tH}ns</text>

      <line class="td-dim" x1={E0} y1={mid("dout") - 14} x2={doutChange} y2={mid("dout") - 14} />
      <text class="td-anntext" x={(E0 + doutChange) / 2} y={mid("dout") - 18}>
        t(clk→Q)≈{tCQ}ns
      </text>
    </g>
  </svg>
  <figcaption>
    Synchronous read then write (schematic — setup/hold shown exaggerated).
    Representative values at the {corner} corner from the macro's Liberate
    <code>.lib</code>; see <a href="/docs/internals/waveforms/">Waveforms</a> for the
    physical bitline behavior.
  </figcaption>
</figure>

<style>
  .td {
    margin: 1.4rem 0;
    border: 1px solid var(--sl-color-hairline-shade, #2a3a55);
    border-radius: 12px;
    padding: 14px 16px 6px;
    background: var(--sl-color-bg-sidebar, #0b1220);
  }
  .td-svg {
    width: 100%;
    height: auto;
    font-family: var(--sram-mono);
  }
  .td-label {
    fill: var(--sl-color-white, var(--sram-text));
    font-size: 13px;
    font-weight: 600;
    text-anchor: end;
  }
  .td-wave {
    fill: none;
    stroke: var(--sram-sky);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .td-bus {
    fill: rgba(101, 175, 255, 0.12);
    stroke: var(--sram-cloud);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .td-buslabel {
    fill: var(--sram-sky-pale);
    font-size: 12px;
    text-anchor: middle;
  }
  .td-invalid {
    fill: rgba(140, 150, 170, 0.18);
    stroke: rgba(140, 150, 170, 0.5);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
  }
  .td-invlabel {
    fill: var(--sram-text-muted);
    font-size: 11px;
    text-anchor: middle;
  }
  .td-guide {
    stroke: var(--sram-sky);
    stroke-opacity: 0.35;
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }
  .td-region {
    fill: var(--sram-text-muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-anchor: middle;
  }
  .td-ann line {
    stroke: var(--sram-signal);
    stroke-width: 1.2;
  }
  .td-ann .td-dim {
    stroke: var(--sram-signal);
    stroke-width: 1.4;
  }
  .td-anntext {
    fill: var(--sram-signal);
    font-size: 11px;
    text-anchor: middle;
  }
  figcaption {
    margin-top: 8px;
    font-size: 0.82rem;
    color: var(--sl-color-gray-3, var(--sram-text-muted));
    line-height: 1.5;
  }
</style>
